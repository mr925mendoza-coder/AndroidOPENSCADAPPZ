# fix-gradle-wrapper.ps1
param(
  [string]$GradleVersion = "8.9",
  [string]$BranchPrefix = "fix/gradle-wrapper",
  [int]$MinJarSizeBytes = 1024
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Write-Info($m){ Write-Host "[INFO] $m" -ForegroundColor Cyan }
function Write-Warn($m){ Write-Host "[WARN] $m" -ForegroundColor Yellow }
function Write-Err($m){ Write-Host "[ERROR] $m" -ForegroundColor Red }

# 1) ensure inside a git repo
try {
  git rev-parse --is-inside-work-tree 2>$null | Out-Null
} catch {
  Write-Err "Not inside a git repository. Run this from the repository root."
  exit 1
}

# 2) ensure working tree is clean or prompt
$porcelain = git status --porcelain
if ($porcelain) {
  Write-Warn "Working tree has uncommitted changes:"
  git status --porcelain
  $ok = Read-Host "Continue anyway? (y/N)"
  if ($ok -ne "y") {
    Write-Err "Aborting. Please stash/commit changes and rerun."
    exit 1
  }
}

# 3) create branch
$branchName = "$BranchPrefix-$([DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))"
Write-Info "Creating branch: $branchName"
git checkout -b $branchName

# 4) remove bogus items locally (but also stage removal if present in git)
$bogusPaths = @("CLASSPATH=$APP_HOME","gardle","OpenAppz/gradle.wrap")
foreach ($p in $bogusPaths) {
  if (Test-Path $p) {
    Write-Warn "Removing bogus path: $p"
    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $p
  } else {
    Write-Info "Bogus path not present: $p"
  }
  # stage removal if it was tracked
  git rm -rf --ignore-unmatch $p 2>$null | Out-Null
}

# 5) create gradle/wrapper folder
$wrapperDir = "gradle\wrapper"
if (-not (Test-Path $wrapperDir)) {
  New-Item -ItemType Directory -Path $wrapperDir -Force | Out-Null
  Write-Info "Created folder: $wrapperDir"
} else {
  Write-Info "Folder already exists: $wrapperDir"
}

# 6) write gradle/wrapper/gradle-wrapper.properties
$propsPath = Join-Path $wrapperDir "gradle-wrapper.properties"
$propsContent = @"
distributionBase=GRADLE_USER_HOME
distributionPath=wrapper/dists
zipStoreBase=GRADLE_USER_HOME
zipStorePath=wrapper/dists
distributionUrl=https\://services.gradle.org/distributions/gradle-$GradleVersion-bin.zip
"@.Trim()

Write-Info "Writing $propsPath"
$propsContent | Out-File -FilePath $propsPath -Encoding utf8 -Force

# 7) write gradlew (Unix) script (if missing)
$gradlewPath = "gradlew"
if (-not (Test-Path $gradlewPath)) {
  Write-Info "Creating $gradlewPath (Unix wrapper script)"
  $gradlewContent = @'
#!/usr/bin/env sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
  echo "Gradle Wrapper JAR not found at $CLASSPATH" >&2
  echo "Run 'gradle wrapper --gradle-version 8.9 --distribution-type bin' locally to generate it." >&2
  exit 1
fi

if [ -n "${JAVA_HOME:-}" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD="java"
fi

exec "$JAVA_CMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
'@
  $gradlewContent | Out-File -FilePath $gradlewPath -Encoding utf8 -Force
  # Make executable (use Git Bash / WSL or set+chmod doesn't matter on Windows, but do it)
  try { icacls $gradlewPath /grant Everyone:RX | Out-Null } catch {}
} else {
  Write-Info "$gradlewPath already exists"
}

# 8) write gradlew.bat (Windows) script (if missing)
$gradlewBatPath = "](#)
